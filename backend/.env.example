# Desarrollo local contra el Postgres de Docker (docker compose up -d db).
# Usuario, contraseña y base deben coincidir con el .env de la raíz.
# SQLite no está soportado: hay migraciones que usan ALTER COLUMN.
DATABASE_URL=postgresql+psycopg://eltunel:change-this-local-password@localhost:5433/eltunel

# Cambiar estos valores antes de usar el entorno fuera de desarrollo.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@localhost.test
SEED_DEMO=false

# Multi-tenant: abrir cada club como http://<subdominio>.localhost:5173
TENANT_BASE_DOMAIN=localhost
# Base de los links que se mandan por email (recuperar contraseña).
CLUB_URL_TEMPLATE=http://{subdominio}.localhost:5173
CLUB_TIMEZONE=America/Argentina/Buenos_Aires
RESEND_API_KEY=
ENVIRONMENT=development
