# Variables usadas por docker compose. Copiar como .env y reemplazar los valores.
POSTGRES_USER=eltunel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=eltunel
POSTGRES_PORT=5433

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEMO=false

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Multi-tenant: cada club se abre en <subdominio>.<TENANT_BASE_DOMAIN>.
# En local se usa localhost: http://el-tunel.localhost:8080
TENANT_BASE_DOMAIN=localhost
CLUB_URL_TEMPLATE=http://{subdominio}.localhost:8080
CLUB_TIMEZONE=America/Argentina/Buenos_Aires
RESEND_API_KEY=
ENVIRONMENT=development
